# USAGE:
#   m4_shim \
#     "+8" ".mrconfigs/_mrconfig-USERNAME.EVAL" \
#     ".mrconfigs/_mrconfig-${DXY_DEPOXY_USERNAME}"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# vim:tw=0:ts=2:sw=2:et:norl:nospell:ft=bash
# DXY_HEADER_AUTHOR
# DXY_HEADER_PROJECT
# DXY_HEADER_LICENSE

# ========================================================================
# ------------------------------------------------------------------------

[DEFAULT]
order = 166

# ========================================================================
# ------------------------------------------------------------------------

# USAGE: Define your own projects herein.

# E.g.,
#
#   [${USERREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/user}/example]
#   ...

# ========================================================================
# ------------------------------------------------------------------------

# USAGE: Load additional personal config.

# E.g.,
#
#   [DEFAULT]
#   include =
#     #
#     dxc_root="${DEPOXYDIR_RUNNING_FULL:-${HOME}/.depoxy/running}"
#     #
#     # CXREF:
#     #   DXY_DEPOXYDIR_STINTS_TILDE/DXY_DEPOXY_CLIENT_ID/.mrconfigs/_mrconfig-DXY_DEPOXY_USERNAME--foo
#     mr_cat "${dxc_root}/.mrconfigs/_mrconfig-DXY_DEPOXY_USERNAME--foo"
#     #
#     # CXREF:
#     #   DXY_DEPOXYDIR_STINTS_TILDE/DXY_DEPOXY_CLIENT_ID/.mrconfigs/_mrconfig-DXY_DEPOXY_USERNAME--bar
#     mr_cat "${dxc_root}/.mrconfigs/_mrconfig-DXY_DEPOXY_USERNAME--bar"

# ========================================================================
# ------------------------------------------------------------------------

# USAGE: Manage 321open encfs project

# CXREF: /Volumes/vestige/.clench

[${ONEOPEN_KEYS_PADDOCK:-${ONEOPEN_MOUNTPOINT:-/Volumes}/vestige/.clench}]
order = 180
lib = remote_set_private
skip = [ ! -d "${MR_REPO}" ] || mr_exclusive "${LOGNAME}"
ffssh =
  git_merge_ffonly_ssh_mirror "$@"
  chmod 2750 .ssh/
  chmod 640 .ssh/authorized_keys*
  chmod 600 .ssh/config*
  chmod 400 .ssh/id_*
  chmod 440 .ssh/id_*.pub

infuseProjlns = OMR_INFUSE_PROJLNS_FILES=true infuse_projlns_if_personal_project
# ALTLY: Be more selective about the ~/.projlns index, e.g.:
#   infuseProjlns =
#     OMR_INFUSE_PROJLNS_FILES=true \
#       infuse_projlns_if_personal_project \
#         ".gitignore" \
#         "README.rst" \
#         ".gnupg/gpg-agent.conf" \
#         ".ssh/config" \
#         ".ssh/config--$(hostname)"

echoInstallHelp =
  local for_what="~/.gnupg, ~/.password-store, ~/.ssh/config"
  # If MR_REPO absent, user needs to create/setup using `321open`.
  # - Though note `mr` normally fails if MR_REPO absent, unless
  #   user allows it via --no-cd, e.g.:
  #     mr --no-cd -d ${MR_REPO} -n echoInstallHelp
  #   - I.e., user won't see our message if they ran
  #     `mr -d ${MR_REPO} echoInstallHelp` or
  #     `mr -d / echoInstallHelp`.
  local install_cmd="321open"
  local description="Create key paddock (for ${for_what})"
  if [ -d "${MR_REPO}" ]; then
    # If MR_REPO present, user can then run the 'install' task
    # (though the project is kinda-technically "installed" at
    #  that point, but 'install' can be used to fix symlinks
    #  and ~/.ssh permissions — though so can running `321open`,
    #  so not really sure there's any benefit to 'install', in
    #  fact it might just represent duplicate technical debt).
    install_cmd="mr -d \"${MR_REPO}\" -n install"
    description="Repair key paddock symlinks (${for_what})"
  fi
  #
  echo "$(echoInstallHelpWidget 'os_all' 'dxy_all'
  ) ${description}::
    ${install_cmd}
  "

install =
  # CXREF: Assumes ~/.config/depoxy/321open.cfg sourced
  #   (which ~/.depoxy/ambers/home/_mrconfig-core does).
  if [ -z "${ONEOPEN_KEYS_PADDOCK}" ]; then
    >&2 warn "ERROR: Cannot ensure Key Paddock symlinks: ONEOPEN_KEYS_PADDOCK unset"
    #
    return 1
  fi
  # SAVVY: Our 'install' task will only recreate/update the 3
  # symlinks — ~/.gnupg, ~/.ssh/config, ~/.password-store —
  # and does not create or setup the gut-plain/ encfs itself.
  # - To setup gut-plain/, user should call 321open themselves.
  #   - It calls ensure_key_paddock_exists which'll automatically
  #     move ~/.gnupg, etc., to the gut-plain/ repo, if necessary,
  #     and create the symlinks.
  # - This 'install' task is really not all that useful.
  #   - Perhaps if something removes a symlink, or, e.g., creates a new
  #     ~/.gnupg or ~/.ssh, or maybe user changes ONEOPEN_KEYS_PADDOCK.
  #   - But otherwise the symlinks should never be removed.
  #     - And they're only ever broken when user first boots,
  #       before they run 321open to mount the encfs(es).
  bash -s <<'[DEFAULT]'
    cd -- "${DOPP_KIT:-${HOME}/.kit}/odd/321open/lib"
    . "${DOPP_KIT:-${HOME}/.kit}/odd/321open/lib/key_paddock.sh"
    #
    # Tell user to manually setup their 321open environment
    # if paddock environ unset, or paddock not a Git repo,
    # or if any of the source paths exist but are not symlinks
    # (e.g., ~/.gnupg is still a directory and has not been
    #  relocated to the paddock yet).
    #
    # COPYD: Similar to 321open's
    #   verify_key_paddock_repo_and_home_dir_symlinks
    # but allow broken symlinks (so not [ -d ]-checks)
    # or ignore if what should be symlink is absent.
    if [ -z "${ONEOPEN_KEYS_PADDOCK}" ] \
      || [ ! -d "${ONEOPEN_KEYS_PADDOCK}/.git" ] \
      || ( [ ! -h "${HOME}/.gnupg" ] && [ -e "${HOME}/.gnupg" ] ) \
      || ( [ ! -h "${HOME}/.ssh/config" ] && [ -e "${HOME}/.ssh/config" ] ) \
      || ( [ ! -h "${HOME}/.password-store" ] && [ -e "${HOME}/.password-store" ] ) \
    ; then
      # Means $ONEOPEN_KEYS_PADDOCK/.git missing (e.g., /Volumes/vestige/.clench/.git);
      # or ~/.gunpg, ~/.ssh/config, and/or ~/.password-store not each a symlink (as
      # setup by `321open`, and `relocate_keys_paddock_dirs`) and not just absent.
      >&2 warn "ERROR: Missing Key Paddock, or home paths not all symlinks"
      >&2 warn "- You'll need to run \`321open\` or manually fix the issue(s)"
      #
      return 1
    fi
    #
    # Recreate the 3 symlinks (using ${MR_REPO} paths).
    ONEOPEN_KEYS_PADDOCK="${ONEOPEN_KEYS_PADDOCK}" \
      ensure_key_paddock_symlinks
 [DEFAULT]
#↓↓↓ So ft=bash stops highlighting the Heredoc.
[DEFAULT]
#↑↑↑ So ft=bash stops highlighting the Heredoc.

# ========================================================================
# ------------------------------------------------------------------------

# *** DepoXy patch transfer repo, used by git-put-wise.

[${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/patchr]
# USAGE: Setup `Host github_user_key` section in ~/.ssh/config and
# make a private GH repository for transferring files, then configure
# the remote here, e.g.,
#
#  lib = remote_set entrust "git@github_user_key:user/patchr.git"

# This repo is mostly managed by git-put-wise, except OMR helps with setup.
skip = no_travel
ffssh = OMR_TRAVEL_BLOCKLISTED=true git_merge_ffonly_ssh_mirror "$@"
fetch = true
update = true
pull = true

lib =
  is_patchr_configured () {
    [ -n "${MR_REPO_REMOTES}" ] && git_remote_exists "entrust"
  }
  #
  insist_patchr_remote_configured () {
    local stream="${1:-echo}"
    if ! is_patchr_configured; then
      ${stream} "Please setup the private GPW patchr repo remote, e.g.::"
      ${stream} "  cd \"${MR_REPO}\" && mropen"
      ${stream} "Pick the running DXC config when prompted:"
      ${stream} "  ${MR_SECTION_CONFIG}"
      ${stream} "Then add something like::"
      ${stream} "  lib = remote_set entrust \"git@github_user_key:user/patchr.git\""
      ${stream} "Add apply it::"
      ${stream} "  mr -d \"${MR_REPO}\" -n wireRemotes"
      #
      return 1
    fi
  }
echoInstallHelp =
  echo "$(echoInstallHelpWidget 'os_all' 'dxy_all') DepoXy: Setup GPW *patchr* repo remote"
  insist_patchr_remote_configured "echo" | sed 's/^/  /'
infuse = insist_patchr_remote_configured "warn"
isInstalled = is_patchr_configured
install = insist_patchr_remote_configured "warn"

# ========================================================================
# ------------------------------------------------------------------------

