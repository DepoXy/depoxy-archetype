# USAGE:
#   m4_shim \
#     "+8" "home/.depoxy/_gitignore.EVAL" \
#     "home/.depoxy/_gitignore"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# vim:tw=0:ts=2:sw=2:et:norl:ft=gitignore
# DXY_HEADER_AUTHOR
# DXY_HEADER_PROJECT
# DXY_HEADER_LICENSE

# USYNC:
#   meld \
#     ~/.depoxy/ambers/archetype/home/.depoxy/_gitignore.EVAL \
#     ~/.depoxy/running/home/.depoxy/_gitignore &

# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# *** DepoXy artifacts (DepoXy Dev. Environment Composer-Orchestrator | DDECO).

# This file, hard link btw. ~/.depoxy/.gitignore
#  <-> ~/.depoxy/running/home/.depoxy/_gitignore:
/.gitignore

# Main DepoXy repo, aka DepoXy Ambers.
# E.g., /ambers/
/DXY_DEPOXYAMBERS_NAME/

# The git-put-wise patches repo, for secure push/pull using encrypted patches.
# The git-put-wise patches repo, for secure push/pull using encrypted patches,
# aka git-put-wise transport repo.
/DXY_PW_PATCHES_NAME/

# Symlink to active DepoXy Client.
#  running -> DXY_DEPOXYDIR_STINTS_NAME/DXY_DEPOXY_CLIENT_ID
/DXY_DEPOXYDIR_RUNNING_NAME

# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
# *** DepoXy Client artifacts.

/DXY_DEPOXYDIR_STINTS_NAME/.ignore

# The @biz-specific DepoXy Client.
/DXY_DEPOXYDIR_STINTS_NAME/DXY_DEPOXY_CLIENT_ID/

# DXC symlinks named like DepoXy Archetype templates, for diffing.
/DXY_DEPOXYDIR_STINTS_NAME/.syml--*

# ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

