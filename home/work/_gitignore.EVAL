# USYNC:
#   meld \
#     ~/.depoxy/ambers/archetype/home/work/_gitignore.EVAL \
#     ~/.depoxy/running/home/work/_gitignore &

/.gitignore
/.ignore
/.mrinfuse

/VENDOR_ORG01_NAME/.ignore
/VENDOR_ORG01_NAME/ignore-tests--VENDOR_ORG01_PROJ01_NAME/
/VENDOR_ORG01_NAME/VENDOR_ORG01_PROJ01_NAME/

/VENDOR_ORG02_NAME/.ignore
/VENDOR_ORG02_NAME/VENDOR_ORG02_PROJ01_NAME/

